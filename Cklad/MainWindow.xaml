<Window x:Class="Cklad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление складом" Height="600" Width="900"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="15">
            <StackPanel Orientation="Horizontal">

                <Button Content="🏠 Организации"
                        Command="{Binding NavigateToOrganizationsCommand}"
                        Background="Transparent"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="5,2"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <TextBlock Text="  ➜  "
                           Foreground="White"
                           VerticalAlignment="Center"
                           Visibility="{Binding SelectedOrganization,
                                       Converter={StaticResource NullToVisibility}}"/>

                <Button Content="{Binding SelectedOrganization.Name}"
                        Command="{Binding NavigateToWarehousesCommand}"
                        Background="#ECF0F1"
                        Foreground="Black"
                        FontWeight="SemiBold"
                        Padding="8,3"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="{Binding SelectedOrganization,
                                    Converter={StaticResource NullToVisibility}}"/>

                <TextBlock Text="  ➜  "
                           Foreground="White"
                           VerticalAlignment="Center"
                           Visibility="{Binding SelectedWarehouse,
                                       Converter={StaticResource NullToVisibility}}"/>

                <Border Background="#ECF0F1"
                        Padding="8,3"
                        CornerRadius="3"
                        Visibility="{Binding SelectedWarehouse,
                                    Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding SelectedWarehouse.Name}"
                               Foreground="Black"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentViewModel}"
                        Margin="10"/>
    </Grid>
</Window>