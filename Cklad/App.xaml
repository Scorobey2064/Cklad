<Application x:Class="Cklad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Cklad.Core.ViewModels;assembly=Cklad.Core"
             xmlns:views="clr-namespace:Cklad.Views"
             xmlns:conv="clr-namespace:Cklad.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3498DB"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:OrganizationViewModel}">
            <views:OrganizationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WarehouseViewModel}">
            <views:WarehouseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <views:ProductView />
        </DataTemplate>
    </Application.Resources>
</Application>
