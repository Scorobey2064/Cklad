<Window x:Class="Cklad.Dialogs.InvoicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список накладных" Height="520" Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="InvoicesGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="100"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"
                                    Width="150"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TypeDisplay}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Позиций" Binding="{Binding Items.Count}" Width="80"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSum, StringFormat=C}" Width="120"/>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Просмотреть детали" Click="ViewDetails_Click"/>
                    <MenuItem Header="Отменить проведение" Click="Unpost_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Детали" Width="120" Click="ViewDetails_Click" Margin="5"/>
            <Button Content="Отменить проведение" Width="180" Click="Unpost_Click"
                    Background="#E74C3C" Margin="5"/>
            <Button Content="Закрыть" Width="100" Click="Close_Click"
                    Background="#7F8C8D" IsCancel="True" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
