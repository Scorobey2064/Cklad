<Window x:Class="Cklad.Dialogs.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Накладная" Height="550" Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Тип накладной:" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="TypeBox" SelectedIndex="0" Width="200" Padding="5">
                <ComboBoxItem Content="Приход"/>
                <ComboBoxItem Content="Расход"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Дата:" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="DateBox" Width="200"
                        SelectedDate="{Binding Date}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,5">
            <TextBlock Text="Товары в накладной:" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="➕ Добавить строку"
                    Click="AddRow_Click"
                    Background="#27AE60"
                    Padding="12,4" Margin="20,0,0,0"/>
            <Button Content="✖ Удалить строку"
                    Click="DeleteRow_Click"
                    Background="#E74C3C"
                    Padding="12,4" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="ItemsGrid"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  RowHeight="35">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Товар" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ProductCombo_SelectionChanged"
                                      Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price, StringFormat=C}"
                                    Width="120" IsReadOnly="True"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Total, StringFormat=C}"
                                    Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="100" Click="Ok_Click"
                    IsDefault="True" Margin="5" Padding="5,3"/>
            <Button Content="Отмена" Width="100" Click="Cancel_Click"
                    IsCancel="True" Margin="5" Padding="5,3"/>
        </StackPanel>
    </Grid>
</Window>